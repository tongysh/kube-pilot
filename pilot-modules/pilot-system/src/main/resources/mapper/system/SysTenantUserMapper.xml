<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kube.pilot.system.mapper.SysTenantUserMapper">

    <resultMap type="com.kube.pilot.system.domain.vo.SysUserVo" id="userVoResultMap">
        <id property="userId" column="user_id"/>
    </resultMap>
    <resultMap type="com.kube.pilot.system.domain.vo.SysTenantVo" id="tenantVoResultMap">
        <id property="id" column="id"/>
        <result property="" column="tenant_code"/>
        <result property="" column="tenant_code"/>
        <result property="" column="tenant_code"/>
        <result property="" column="tenant_code"/>
    </resultMap>



    <select id="getAllManageTenantOfUser" resultMap="tenantVoResultMap">
        select
            st.*
        from
            sys_tenant_user stu
                left join sys_tenant st on
                stu.tenant_id = st.id
        where
            stu.user_id = 3
          and st.status = 0
    </select>



    <select id="getAllUserOfTenant">
        select
            su.*
        from
            sys_tenant_user stu
                left join sys_user su on
                stu.user_id = su.id
        where
            stu.tenant_id = 3
          and su.status = 0
    </select>
</mapper>
